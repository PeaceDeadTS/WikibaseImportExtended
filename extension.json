{
	"name": "WikibaseImportExtended",
	"version": "0.4.1",
	"author": [
		"Katie Filbert",
		"PeaceDeadTS"
	],
	"url": "https://github.com/PeaceDeadTS/WikibaseImportExtended",
	"descriptionmsg": "wikibaseimport-desc",
	"license-name": "MIT",
	"type": "wikibase",
	"manifest_version": 2,
	"requires": {
		"MediaWiki": ">= 1.44.0",
		"extensions": {
			"WikibaseRepository": "*"
		}
	},
	"AutoloadNamespaces": {
		"Wikibase\\Import\\": "src/"
	},
	"callback": "Wikibase\\Import\\Hooks::onRegistration",
	"AvailableRights": [
		"wikibaseimport"
	],
	"SpecialPages": {
		"WikibaseImport": "Wikibase\\Import\\Special\\SpecialWikibaseImport"
	},
	"APIModules": {
		"wikibaseimport": "Wikibase\\Import\\Api\\ApiWikibaseImport"
	},
	"Hooks": {
		"LoadExtensionSchemaUpdates": "Wikibase\\Import\\Hooks::onLoadExtensionSchemaUpdates",
		"SidebarBeforeOutput": "Wikibase\\Import\\Hooks::onSidebarBeforeOutput"
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "WikibaseImportExtended/resources"
	},
	"ResourceModules": {
		"ext.wikibaseimport.styles": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexStyleOnly": true,
			"codexComponents": [
				"CdxButton",
				"CdxCheckbox",
				"CdxField",
				"CdxLabel",
				"CdxMessage",
				"CdxProgressBar",
				"CdxTable",
				"CdxTextInput"
			]
		},
		"ext.wikibaseimport": {
			"scripts": [
				"ext.wikibaseimport.js"
			],
			"styles": [
				"ext.wikibaseimport.css"
			],
			"dependencies": [
				"mediawiki.api"
			],
			"messages": [
				"wikibaseimport-check-ok",
				"wikibaseimport-check-warn",
				"wikibaseimport-check-error",
				"wikibaseimport-import-ok",
				"wikibaseimport-import-warn",
				"wikibaseimport-import-error",
				"wikibaseimport-bot-flag",
				"wikibaseimport-mode-statements",
				"wikibaseimport-mode-terms",
				"wikibaseimport-related-count",
				"wikibaseimport-mode-mismatch",
				"wikibaseimport-on",
				"wikibaseimport-off",
				"wikibaseimport-log",
				"wikibaseimport-col-id",
				"wikibaseimport-col-label",
				"wikibaseimport-col-action",
				"wikibaseimport-col-terms",
				"wikibaseimport-col-statements",
				"wikibaseimport-col-sitelinks",
				"wikibaseimport-col-local",
				"wikibaseimport-action-create",
				"wikibaseimport-action-exists",
				"wikibaseimport-action-created",
				"wikibaseimport-action-statements",
				"wikibaseimport-statements-plan",
				"wikibaseimport-empty-entity",
				"wikibaseimport-request-failed",
				"wikibaseimport-stale",
				"wikibaseimport-pending-check",
				"wikibaseimport-pending-import"
			]
		}
	},
	"config": {
		"WBImportSourceApi": {
			"value": "https://www.wikidata.org/w/api.php",
			"description": "API endpoint of the source Wikibase (wbgetentities)."
		},
		"WBImportQueryUrl": {
			"value": "https://query.wikidata.org/sparql",
			"description": "SPARQL endpoint used by the --query option."
		},
		"WBImportQueryPrefixes": {
			"value": {
				"wikibase": "http://wikiba.se/ontology#",
				"wd": "http://www.wikidata.org/entity/",
				"wdt": "http://www.wikidata.org/prop/direct/",
				"rdfs": "http://www.w3.org/2000/01/rdf-schema#"
			},
			"description": "SPARQL prefixes for the --query option."
		},
		"WBImportSourcePropertyNamespace": {
			"value": 120,
			"description": "Namespace id of properties on the source wiki. Wikidata uses 120."
		},
		"WBImportUser": {
			"value": "WikibaseImport",
			"description": "Existing local user that owns imported revisions when --user and the web form leave the name empty. An empty value falls back to WikibaseImport."
		},
		"WBImportGroups": {
			"value": [ "sysop", "bureaucrat" ],
			"merge_strategy": "provide_default",
			"description": "User groups that receive the wikibaseimport right when the extension loads. Set this in LocalSettings to replace the list. The group * is ignored."
		},
		"WBImportSitelinks": {
			"value": false,
			"description": "Keep source sitelinks. Leave false unless those site ids exist in the local sites table."
		},
		"WBImportStatements": {
			"value": false,
			"description": "Copy statements of requested entities. Leave false to import labels, descriptions and aliases only. Override with --statements."
		},
		"WBImportUserAgent": {
			"value": "WikibaseImportExtended/0.3 (https://pornbasedata.com)",
			"description": "HTTP User-Agent sent to the source API and SPARQL endpoint."
		}
	},
	"MessagesDirs": {
		"WikibaseImportExtended": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"WikibaseImportAlias": "WikibaseImport.i18n.alias.php"
	}
}
